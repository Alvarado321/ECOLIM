					}
				},
				{
					"name": "Eliminar empleado",
					"request": {
						"method": "DELETE",
						"url": "{{base_url}}/empleados/1"
					}
				},
				{
					"name": "Login empleado",
					"request": {
						"method": "POST",
						"url": "{{base_url}}/empleados/login",
