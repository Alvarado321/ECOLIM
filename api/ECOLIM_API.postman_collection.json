				},
				{
					"name": "Crear empleado",
					"request": {
						"method": "POST",
						"url": "{{base_url}}/empleados",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n\t\"nombre\": \"Juan Pérez\",\n\t\"email\": \"juan@example.com\",\n\t\"password\": \"123456\"\n}"
						}
					}
				},
				{
